{
  "name": "messenger-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && node server.cjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "stylelint": "stylelint \"src/**/*.{css,pcss}\"",
    "stylelint:fix": "stylelint \"src/**/*.{css,pcss}\" --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "NODE_OPTIONS='--loader ts-node/esm --experimental-specifier-resolution=node --no-warnings' mocha \"src/**/*.test.ts\"",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@stylistic/stylelint-plugin": "^4.0.0",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^24.3.0",
    "@types/sinon": "^17.0.3",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "autoprefixer": "^10.4.19",
    "chai": "^4.3.10",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^8.0.3",
    "jsdom": "^26.1.0",
    "jsdom-global": "^3.0.2",
    "lint-staged": "^15.2.0",
    "mocha": "^10.2.0",
    "postcss": "^8.4.40",
    "postcss-preset-env": "^9.6.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.6.2",
    "sinon": "^17.0.1",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-order": "^6.0.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.12.2",
    "vite": "^4.5.0"
  },
  "dependencies": {
    "express": "^4.19.2",
    "globals": "^16.3.0",
    "handlebars": "^4.7.7"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,pcss}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,html}": "prettier --write"
  }
}
