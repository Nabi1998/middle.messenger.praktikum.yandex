<div class="chat-page">
  <div class="chat-sidebar">
    <div class="chat-header">
      <h2>Чаты</h2>
      <button class="new-chat-btn">+</button>
    </div>
    <div class="chat-list">
      {{#each chats}}
        <div class="chat-item" data-chat-id="{{id}}">
          <div class="chat-avatar">👤</div>
          <div class="chat-info">
            <div class="chat-title">{{title}}</div>
            <div class="chat-last-message">{{lastMessage}}</div>
          </div>
          {{#if unreadCount}}
            <div class="chat-unread">{{unreadCount}}</div>
          {{/if}}
        </div>
      {{/each}}
    </div>
  </div>
  
  <div class="chat-main">
    <div class="chat-messages">
      <div class="chat-placeholder">
        <h3>Выберите чат для начала общения</h3>
        <p>Здесь будут отображаться сообщения выбранного чата</p>
      </div>
    </div>
    
    <div class="chat-input-area">
      <form class="message-form">
        <input type="text" class="message-input" placeholder="Введите сообщение..." disabled>
        <button type="submit" class="send-btn" disabled>Отправить</button>
      </form>
    </div>
  </div>
</div>