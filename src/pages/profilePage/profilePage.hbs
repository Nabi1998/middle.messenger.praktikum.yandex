<main>
  <div class='profile-page'>
    <div class='profile-card'>
<!--      <div class='profile-avatar'>{{avatar}}</div>-->
      <div class="profile-avatar">
        {{#if avatar}}
          <img src="{{avatar}}" alt="Avatar" class="avatar-img" />
        {{else}}
          🖼️
        {{/if}}
      </div>
      <div class='profile-name'>{{first_name}}</div>

      <div class='profile-info'>
        <div class='info-row'>
          <div class='label'>Почта</div>
          <div class='value'>{{email}}</div>
        </div>
        <div class='info-row'>
          <div class='label'>Логин</div>
          <div class='value'>{{login}}</div>
        </div>
        <div class='info-row'>
          <div class='label'>Имя</div>
          <div class='value'>{{first_name}}</div>
        </div>
        <div class='info-row'>
          <div class='label'>Фамилия</div>
          <div class='value'>{{second_name}}</div>
        </div>
        <div class='info-row'>
          <div class='label'>Имя в чате</div>
          <div class='value'>{{display_name}}</div>
        </div>
        <div class='info-row'>
          <div class='label'>Телефон</div>
          <div class='value'>{{phone}}</div>
        </div>
      </div>

      <div class='profile-actions'>
        <a href='/edit-profile' class='action-link' data-route='/edit-profile'>Изменить данные</a>
        <a href='/change-password' class='action-link' data-route='/change-password'>Изменить пароль</a>
        <a href='/messenger' class='action-link' data-route='/messenger'>Вернуться к чату</a>
        <button type='button' class='logout-button'>Выйти</button>
      </div>
    </div>
  </div>
</main>
