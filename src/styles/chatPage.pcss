body,
html {
  font-family: sans-serif;
  height: 100%;
  margin: 0;
  padding: 0;
}

.chat-page {
  display: flex;
  height: 100vh;
  overflow: hidden;
  width: 100vw;
}

.sidebar {
  background-color: var(--background-light);
  border-right: 1px solid #ccc;
  display: flex;
  flex-direction: column;
  width: 300px;
}

.sidebar-header {
  border-bottom: 1px solid #ccc;
  padding: 1rem;
}

.chat-list {
  flex-grow: 1;
  list-style: none;
  margin: 0;
  overflow-y: auto;
  padding: 0;
}

.chat-item {
  align-items: center;
  border-bottom: 1px solid #ddd;
  cursor: pointer;
  display: flex;
  padding: 0.8rem;
}

.chat-item.active {
  background-color: #e6e6e6;
}

.avatar {
  border-radius: 50%;
  height: 40px;
  margin-right: 1rem;
  width: 40px;
}

.chat-info {
  display: flex;
  flex-direction: column;
}

.chat-name {
  font-weight: bold;
}

.chat-last-message {
  color: #666;
  font-size: 0.85rem;
}

.chat-window {
  background-color: var(--background-color-white);
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.chat-header {
  align-items: center;
  border-bottom: 1px solid #ccc;
  display: flex;
  padding: 1rem;
}

.chat-title {
  font-size: 1.2rem;
  font-weight: bold;
  margin-left: 1rem;
}

.chat-messages {
  display: flex;
  flex-direction: column;
  flex-grow: 1;
  gap: 0.5rem;
  overflow-y: auto;
  padding: 1rem;
}

.message {
  background-color: #f1f1f1;
  border-radius: 10px;
  max-width: 60%;
  padding: 0.8rem;
}

.message.from {
  align-self: flex-start;
  background-color: #e0e0e0;
}

.message.to {
  align-self: flex-end;
  background-color: #d1e7dd;
}

.chat-input {
  border-top: 1px solid #ccc;
  display: flex;
  padding: 1rem;
}

.chat-input input {
  border: 1px solid #ccc;
  border-radius: 20px;
  flex-grow: 1;
  font-size: 1rem;
  outline: none;
  padding: 0.8rem;
}

.chat-input button {
  background-color: var(--primary-color);
  border: none;
  border-radius: 20px;
  color: white;
  cursor: pointer;
  margin-left: 1rem;
  padding: 0.8rem 1.2rem;
}
