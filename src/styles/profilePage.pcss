body {
  background-color: #f5f5f5;
  font-family: 'Segoe UI', sans-serif;
  margin: 0;
}

.profile-page {
  align-items: center;
  display: flex;
  height: 100vh;
  justify-content: center;
}

.profile-card {
  background-color: white;
  box-shadow: 0 0 20px rgb(0 0 0 / 5%);
  padding: 40px;
  text-align: center;
  width: 500px;
}

.profile-avatar {
  background-color: #ececec;
  background-image: url('/avatar-placeholder.svg'); /* замените при необходимости */
  background-position: center;
  background-repeat: no-repeat;
  background-size: 50%;
  border-radius: 50%;
  height: 100px;
  margin: 0 auto 15px;
  width: 100px;
}

.profile-name {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 30px;
}

.profile-info {
  margin-bottom: 30px;
  text-align: left;
}

.info-row {
  border-bottom: 1px solid #eee;
  display: flex;
  justify-content: space-between;
  padding: 6px 0;
}

.label {
  color: #999;
  font-size: 14px;
}

.value {
  color: #333;
  font-size: 14px;
}

.profile-actions {
  display: flex;
  flex-direction: column;
  gap: 10px;
  text-align: left;
}

.action-link {
  color: var(--primary-color);
  font-size: 14px;
  text-decoration: none;
}

.logout-button {
  background: none;
  border: none;
  color: red;
  cursor: pointer;
  font-size: 14px;
  padding: 0;
  text-align: left;
}
