body {
  background: #f5f5f5;
  font-family: sans-serif;
  margin: 0;
}

.edit-profile-page {
  align-items: center;
  display: flex;
  height: 100vh;
  justify-content: center;
}

.edit-profile-card {
  background: #fff;
  border-radius: 8px;
  box-shadow: 0 0 10px rgb(0 0 0 / 10%);
  padding: 40px;
  text-align: center;
  width: 400px;
}

.edit-profile-avatar {
  align-items: center;
  background: #e0e0e0;
  border-radius: 50%;
  display: flex;
  height: 80px;
  justify-content: center;
  margin: 0 auto 20px;
  width: 80px;
}

.edit-profile-name {
  font-size: 20px;
  margin-bottom: 20px;
}

.edit-profile-info {
  text-align: left;
}

.edit-profile-info-row {
  margin-bottom: 15px;
}

.edit-profile-label {
  color: #888;
  display: block;
  font-size: 14px;
  margin-bottom: 5px;
}

.edit-profile-input {
  border: 1px solid #ccc;
  border-radius: 4px;
  box-sizing: border-box;
  font-size: 16px;
  padding: 8px 12px;
  width: 100%;
}

.edit-profile-actions {
  margin-top: 20px;
}

.edit-profile-button {
  background-color: var(--primary-color);
  border: none;
  border-radius: 4px;
  color: #fff;
  cursor: pointer;
  font-size: 16px;
  padding: 10px;
  width: 100%;
}

.edit-profile-button:hover {
  background-color: var(--primary-color);
}

.edit-profile-avatar-modal {
  align-items: center;
  background: rgb(0 0 0 / 50%);
  display: flex;
  height: 100%;
  justify-content: center;
  left: 0;
  position: fixed;
  top: 0;
  width: 100%;
  z-index: 1000;
}

.edit-profile-avatar-card {
  background: #fff;
  border-radius: 8px;
  box-shadow: 0 0 10px rgb(0 0 0 / 20%);
  padding: 30px;
  text-align: center;
  width: 300px;
}

.edit-profile-avatar-title {
  font-size: 18px;
  margin-bottom: 20px;
}

.edit-profile-avatar-upload {
  color: var(--primary-color);
  cursor: pointer;
  display: inline-block;
  font-size: 14px;
  margin-bottom: 20px;
}

.edit-profile-avatar-input {
  display: none;
}

.edit-profile-avatar-actions {
  margin-top: 10px;
}

.edit-profile-avatar-button {
  background-color: var(--primary-color);
  border: none;
  border-radius: 4px;
  color: #fff;
  cursor: pointer;
  font-size: 16px;
  padding: 10px;
  width: 100%;
}

.edit-profile-avatar-button:hover {
  background-color: var(--primary-color);
}

.hidden {
  display: none;
}
