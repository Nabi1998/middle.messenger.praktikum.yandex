.change-password-page {
  align-items: center;
  background-color: #e5e5e5;
  display: flex;
  justify-content: center;
}

.change-password-card {
  background-color: #fff;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgb(0 0 0 / 10%);
  padding: 40px;
  text-align: center;
  width: 600px;
}

.change-password-avatar {
  background-color: #eee;
  background-image: url(''); /* Можно добавить иконку */
  background-position: center;
  background-repeat: no-repeat;
  background-size: contain;
  border-radius: 50%;
  height: 80px;
  margin: 0 auto 30px;
  width: 80px;
}

.change-password-form {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-bottom: 30px;
}

.form-row {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.form-label {
  color: #333;
  font-size: 14px;
}

.form-input {
  background: transparent;
  border: none;
  border-bottom: 1px solid #ccc;
  font-size: 14px;
  padding: 8px 12px;
  text-align: right;
  width: 60%;
}

.save-button {
  background-color: var(--primary-color);
  border: none;
  border-radius: 6px;
  color: white;
  cursor: pointer;
  font-size: 14px;
  padding: 10px 0;
  transition: background 0.3s ease;
  width: 160px;
}

.save-button:hover {
  background-color: #1c45cc;
}
