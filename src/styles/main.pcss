:root {
  --primary-color: #3369f3;
  --secondary-color: #2c3e50;
  --background-color: #f4f4f4;
  --text-color: #333;
  --error-color: #e74c3c;
  --background-light: #f2f2f2;
  --background-color-white: #fff;
  --primary-color-blue: #007bff;
}

body {
  align-items: center;
  background-color: #f5f5f5;
  display: flex;
  font-family: Arial, sans-serif;
  justify-content: center;
  line-height: 1.6;
}

.app {
  background-color: var(--background-color);
  border-radius: 5px;
  box-shadow: 0 0 10px rgb(0 0 0 / 10%);
  padding: 20px;
}

h1,
h2,
h3 {
  color: var(--secondary-color);
}

.input,
.select,
.button {
  box-sizing: border-box;
  margin: 10px 0;
  padding: 10px;
  width: 100%;
}

.input {
  border: 1px solid #ddd;
  border-radius: 4px;
  transition: border-color 0.3s ease;

  &:focus {
    border-color: var(--primary-color);
    box-shadow: 0 0 0 2px rgb(51 105 243 / 20%);
    outline: none;
  }

  &.invalid {
    border-color: var(--error-color);
    box-shadow: 0 0 0 2px rgb(231 76 60 / 20%);
  }
}

.error-message {
  color: var(--error-color);
  font-size: 12px;
  margin-top: 4px;
  min-height: 16px;
}

.input-wrapper {
  margin-bottom: 15px;
}

/* Стили для страниц логина и регистрации */
.login-card {
  background: white;
  border-radius: 8px;
  box-shadow: 0 4px 6px rgb(0 0 0 / 10%);
  margin: 0 auto;
  max-width: 400px;
  padding: 30px;
  width: 100%;
}

.login-title {
  color: var(--secondary-color);
  margin-bottom: 30px;
  text-align: center;
}

.login-label {
  color: var(--text-color);
  display: block;
  font-weight: bold;
  margin-bottom: 8px;
}

.login-footer {
  margin-top: 20px;
  text-align: center;
}

.footer-link {
  color: var(--primary-color);
  font-weight: bold;
  text-decoration: none;
}

.footer-link:hover {
  text-decoration: underline;
}

/* Стили для страницы редактирования профиля */
.edit-profile-page {
  margin: 0 auto;
  max-width: 800px;
  padding: 20px;
}

.edit-profile-card {
  background: white;
  border-radius: 8px;
  box-shadow: 0 4px 6px rgb(0 0 0 / 10%);
  padding: 30px;
}

.edit-profile-avatar {
  cursor: pointer;
  font-size: 48px;
  margin-bottom: 20px;
  text-align: center;
}

.edit-profile-name {
  color: var(--secondary-color);
  font-size: 24px;
  font-weight: bold;
  margin-bottom: 30px;
  text-align: center;
}

.edit-profile-info {
  margin-bottom: 30px;
}

.edit-profile-info-row {
  margin-bottom: 20px;
}

.edit-profile-label {
  color: var(--text-color);
  display: block;
  font-weight: bold;
  margin-bottom: 8px;
}

.edit-profile-actions {
  text-align: center;
}

/* Модальное окно аватара */
.edit-profile-avatar-modal {
  align-items: center;
  background: rgb(0 0 0 / 50%);
  display: flex;
  height: 100%;
  justify-content: center;
  left: 0;
  position: fixed;
  top: 0;
  width: 100%;
  z-index: 1000;
}

.edit-profile-avatar-modal.hidden {
  display: none;
}

.edit-profile-avatar-card {
  background: white;
  border-radius: 8px;
  max-width: 400px;
  padding: 30px;
  text-align: center;
  width: 90%;
}

.edit-profile-avatar-title {
  color: var(--secondary-color);
  font-size: 20px;
  font-weight: bold;
  margin-bottom: 20px;
}

.edit-profile-avatar-upload {
  background: var(--primary-color);
  border-radius: 6px;
  color: #fff;
  cursor: pointer;
  display: inline-block;
  margin-bottom: 20px;
  padding: 12px 24px;
}

.edit-profile-avatar-input {
  display: none;
}

.edit-profile-avatar-actions {
  margin-top: 20px;
}

/* Стили для страницы смены пароля */
.change-password-page {
  margin: 0 auto;
  max-width: 600px;
  padding: 20px;
}

.change-password-card {
  background: white;
  border-radius: 8px;
  box-shadow: 0 4px 6px rgb(0 0 0 / 10%);
  padding: 30px;
}

.change-password-avatar {
  font-size: 48px;
  margin-bottom: 20px;
  text-align: center;
}

.form-row {
  margin-bottom: 20px;
}

.form-label {
  color: var(--text-color);
  display: block;
  font-weight: bold;
  margin-bottom: 8px;
}

.change-password-actions {
  margin-top: 30px;
  text-align: center;
}

.save-button {
  background: var(--primary-color);
  border: none;
  border-radius: 6px;
  color: white;
  cursor: pointer;
  font-size: 16px;
  padding: 12px 24px;
}

.save-button:hover {
  background: color-mix(in srgb, var(--primary-color) 80%, black);
}

/* Стили для страницы профиля */
.profile-page {
  margin: 0 auto;
  max-width: 600px;
  padding: 20px;
}

.profile-card {
  background: white;
  border-radius: 8px;
  box-shadow: 0 4px 6px rgb(0 0 0 / 10%);
  padding: 30px;
}

.profile-avatar {
  font-size: 48px;
  margin-bottom: 20px;
  text-align: center;
}

.profile-name {
  color: var(--secondary-color);
  font-size: 24px;
  font-weight: bold;
  margin-bottom: 30px;
  text-align: center;
}

.profile-info {
  margin-bottom: 30px;
}

.info-row {
  border-bottom: 1px solid #eee;
  display: flex;
  justify-content: space-between;
  padding: 15px 0;
}

.info-row:last-child {
  border-bottom: none;
}

.label {
  color: var(--text-color);
  font-weight: bold;
}

.value {
  color: var(--secondary-color);
}

.profile-actions {
  text-align: center;
}

.action-link {
  border: 2px solid var(--primary-color);
  border-radius: 6px;
  color: var(--primary-color);
  display: inline-block;
  font-weight: bold;
  margin: 10px;
  padding: 10px 20px;
  text-decoration: none;
  transition: all 0.3s ease;
}

.action-link:hover {
  background: var(--primary-color);
  color: white;
}

.logout-button {
  background: #e74c3c;
  border: none;
  border-radius: 6px;
  color: white;
  cursor: pointer;
  font-size: 16px;
  margin-top: 20px;
  padding: 12px 24px;
}

.logout-button:hover {
  background: #c0392b;
}

/* Стили для страниц ошибок */
.error-page {
  margin: 0 auto;
  max-width: 600px;
  padding: 20px;
  text-align: center;
}

.error-content {
  background: white;
  border-radius: 8px;
  box-shadow: 0 4px 6px rgb(0 0 0 / 10%);
  padding: 50px 30px;
}

.error-code {
  color: var(--error-color);
  font-size: 72px;
  font-weight: bold;
  margin: 0 0 20px;
}


.back-button {
  border: 2px solid var(--primary-color);
  border-radius: 6px;
  color: var(--primary-color);
  display: inline-block;
  font-weight: bold;
  padding: 12px 24px;
  text-decoration: none;
  transition: all 0.3s ease;
}

.back-button:hover {
  background: var(--primary-color);
  color: white;
}

/* Стили для чата */
.chat-page {
  display: flex;
  height: 100vh;
}

.chat-sidebar {
  background: #f5f5f5;
  border-right: 1px solid #ddd;
  width: 300px;
}

.chat-header {
  align-items: center;
  border-bottom: 1px solid #ddd;
  display: flex;
  gap: 10px;
  padding: 15px;
}

.profile-btn, .new-chat-btn {
  background: var(--primary-color);
  border: none;
  border-radius: 4px;
  color: white;
  cursor: pointer;
  padding: 8px 12px;
}

.chat-item {
  align-items: center;
  border-bottom: 1px solid #eee;
  cursor: pointer;
  display: flex;
  gap: 10px;
  padding: 12px;
}

.chat-item:hover {
  background: #e8e8e8;
}

.chat-item.active {
  background: var(--primary-color);
  color: white;
}

.chat-main {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.chat-messages {
  flex: 1;
  overflow-y: auto;
  padding: 20px;
}

.messages {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.message {
  align-self: flex-start;
  background: #f0f0f0;
  border-radius: 12px;
  max-width: 70%;
  padding: 8px 12px;
}

.message.own {
  align-self: flex-end;
  background: var(--primary-color);
  color: white;
}

.chat-input-area {
  border-top: 1px solid #ddd;
  padding: 15px;
}

.message-form {
  align-items: end;
  display: flex;
  gap: 10px;
}

.message-form .input-wrapper {
  flex: 1;
  margin: 0;
}

.send-btn {
  background: var(--primary-color);
  border: none;
  border-radius: 4px;
  color: white;
  cursor: pointer;
  padding: 10px 20px;
}

.button {
  background-color: var(--primary-color);
  border: none;
  border-radius: 8px;
  color: white;
  cursor: pointer;
  transition: background-color 0.3s ease;

  &:hover {
    background-color: color-mix(in srgb, var(--primary-color) 80%, black);
  }

  &:disabled {
    background-color: #bdc3c7;
    cursor: not-allowed;
  }
}

ul {
  list-style-type: none;
  padding: 0;
}

li {
  background-color: white;
  border-radius: 3px;
  box-shadow: 0 0 5px rgb(0 0 0 / 10%);
  margin: 10px 0;
  padding: 10px;
}

.error {
  color: var(--error-color);
  font-weight: bold;
}

.footer {
  border-top: 1px solid var(--secondary-color);
  display: flex;
  justify-content: space-around;
  margin-top: 20px;
  padding-top: 20px;
}
