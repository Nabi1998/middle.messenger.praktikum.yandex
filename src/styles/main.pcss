:root {
  --primary-color: #3369f3;
  --secondary-color: #2c3e50;
  --background-color: #f4f4f4;
  --text-color: #333;
  --error-color: #e74c3c;
  --background-light: #f2f2f2;
  --background-color-white: #fff;
  --primary-color-blue: #007bff;
}
body {
  font-family: Arial, sans-serif;
  line-height: 1.6;
  background-color: #f5f5f5;
  display: flex;
  justify-content: center;
  align-items: center;
}

.app {
  background-color: var(--background-color);
  padding: 20px;
  border-radius: 5px;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

h1,
h2,
h3 {
  color: var(--secondary-color);
}

.input,
.select,
.button {
  margin: 10px 0;
  padding: 10px;
  width: 100%;
  box-sizing: border-box;
}

.input {
  border: 1px solid #ddd;
  border-radius: 4px;
  transition: border-color 0.3s ease;
  
  &:focus {
    outline: none;
    border-color: var(--primary-color);
    box-shadow: 0 0 0 2px rgba(51, 105, 243, 0.2);
  }
  
  &.invalid {
    border-color: var(--error-color);
    box-shadow: 0 0 0 2px rgba(231, 76, 60, 0.2);
  }
}

.error-message {
  color: var(--error-color);
  font-size: 12px;
  margin-top: 4px;
  min-height: 16px;
}

.input-wrapper {
  margin-bottom: 15px;
}

/* Стили для страниц логина и регистрации */
.login-card {
  background: white;
  border-radius: 8px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  padding: 30px;
  max-width: 400px;
  width: 100%;
  margin: 0 auto;
}

.login-title {
  text-align: center;
  margin-bottom: 30px;
  color: var(--secondary-color);
}

.login-label {
  display: block;
  margin-bottom: 8px;
  font-weight: bold;
  color: var(--text-color);
}

.login-footer {
  margin-top: 20px;
  text-align: center;
}

.footer-link {
  color: var(--primary-color);
  text-decoration: none;
  font-weight: bold;
}

.footer-link:hover {
  text-decoration: underline;
}

/* Стили для страницы редактирования профиля */
.edit-profile-page {
  max-width: 800px;
  margin: 0 auto;
  padding: 20px;
}

.edit-profile-card {
  background: white;
  border-radius: 8px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  padding: 30px;
}

.edit-profile-avatar {
  text-align: center;
  font-size: 48px;
  margin-bottom: 20px;
  cursor: pointer;
}

.edit-profile-name {
  text-align: center;
  font-size: 24px;
  font-weight: bold;
  margin-bottom: 30px;
  color: var(--secondary-color);
}

.edit-profile-info {
  margin-bottom: 30px;
}

.edit-profile-info-row {
  margin-bottom: 20px;
}

.edit-profile-label {
  display: block;
  margin-bottom: 8px;
  font-weight: bold;
  color: var(--text-color);
}

.edit-profile-actions {
  text-align: center;
}

/* Модальное окно аватара */
.edit-profile-avatar-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.edit-profile-avatar-modal.hidden {
  display: none;
}

.edit-profile-avatar-card {
  background: white;
  border-radius: 8px;
  padding: 30px;
  text-align: center;
  max-width: 400px;
  width: 90%;
}

.edit-profile-avatar-title {
  font-size: 20px;
  font-weight: bold;
  margin-bottom: 20px;
  color: var(--secondary-color);
}

.edit-profile-avatar-upload {
  display: inline-block;
  background: var(--primary-color);
  color: white;
  padding: 12px 24px;
  border-radius: 6px;
  cursor: pointer;
  margin-bottom: 20px;
}

.edit-profile-avatar-input {
  display: none;
}

.edit-profile-avatar-actions {
  margin-top: 20px;
}

/* Стили для страницы смены пароля */
.change-password-page {
  max-width: 600px;
  margin: 0 auto;
  padding: 20px;
}

.change-password-card {
  background: white;
  border-radius: 8px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  padding: 30px;
}

.change-password-avatar {
  text-align: center;
  font-size: 48px;
  margin-bottom: 20px;
}

.form-row {
  margin-bottom: 20px;
}

.form-label {
  display: block;
  margin-bottom: 8px;
  font-weight: bold;
  color: var(--text-color);
}

.change-password-actions {
  text-align: center;
  margin-top: 30px;
}

.save-button {
  background: var(--primary-color);
  color: white;
  border: none;
  padding: 12px 24px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 16px;
}

.save-button:hover {
  background: color-mix(in srgb, var(--primary-color) 80%, black);
}

/* Стили для страницы профиля */
.profile-page {
  max-width: 600px;
  margin: 0 auto;
  padding: 20px;
}

.profile-card {
  background: white;
  border-radius: 8px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  padding: 30px;
}

.profile-avatar {
  text-align: center;
  font-size: 48px;
  margin-bottom: 20px;
}

.profile-name {
  text-align: center;
  font-size: 24px;
  font-weight: bold;
  margin-bottom: 30px;
  color: var(--secondary-color);
}

.profile-info {
  margin-bottom: 30px;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 15px 0;
  border-bottom: 1px solid #eee;
}

.info-row:last-child {
  border-bottom: none;
}

.label {
  font-weight: bold;
  color: var(--text-color);
}

.value {
  color: var(--secondary-color);
}

.profile-actions {
  text-align: center;
}

.action-link {
  display: inline-block;
  color: var(--primary-color);
  text-decoration: none;
  font-weight: bold;
  margin: 10px;
  padding: 10px 20px;
  border: 2px solid var(--primary-color);
  border-radius: 6px;
  transition: all 0.3s ease;
}

.action-link:hover {
  background: var(--primary-color);
  color: white;
}

.logout-button {
  background: #e74c3c;
  color: white;
  border: none;
  padding: 12px 24px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 16px;
  margin-top: 20px;
}

.logout-button:hover {
  background: #c0392b;
}

/* Стили для страниц ошибок */
.error-page {
  max-width: 600px;
  margin: 0 auto;
  padding: 20px;
  text-align: center;
}

.error-content {
  background: white;
  border-radius: 8px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  padding: 50px 30px;
}

.error-code {
  font-size: 72px;
  font-weight: bold;
  color: var(--error-color);
  margin: 0 0 20px 0;
}

.error-message {
  font-size: 24px;
  color: var(--text-color);
  margin-bottom: 30px;
}

.back-button {
  display: inline-block;
  color: var(--primary-color);
  text-decoration: none;
  font-weight: bold;
  padding: 12px 24px;
  border: 2px solid var(--primary-color);
  border-radius: 6px;
  transition: all 0.3s ease;
}

.back-button:hover {
  background: var(--primary-color);
  color: white;
}

/* Стили для чата */
.chat-page {
  display: flex;
  height: 100vh;
}

.chat-sidebar {
  width: 300px;
  background: #f5f5f5;
  border-right: 1px solid #ddd;
}

.chat-header {
  padding: 15px;
  border-bottom: 1px solid #ddd;
  display: flex;
  align-items: center;
  gap: 10px;
}

.profile-btn, .new-chat-btn {
  background: var(--primary-color);
  color: white;
  border: none;
  padding: 8px 12px;
  border-radius: 4px;
  cursor: pointer;
}

.chat-item {
  padding: 12px;
  border-bottom: 1px solid #eee;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 10px;
}

.chat-item:hover {
  background: #e8e8e8;
}

.chat-item.active {
  background: var(--primary-color);
  color: white;
}

.chat-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.chat-messages {
  flex: 1;
  padding: 20px;
  overflow-y: auto;
}

.messages {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.message {
  padding: 8px 12px;
  background: #f0f0f0;
  border-radius: 12px;
  max-width: 70%;
  align-self: flex-start;
}

.message.own {
  background: var(--primary-color);
  color: white;
  align-self: flex-end;
}

.chat-input-area {
  padding: 15px;
  border-top: 1px solid #ddd;
}

.message-form {
  display: flex;
  gap: 10px;
  align-items: end;
}

.message-form .input-wrapper {
  flex: 1;
  margin: 0;
}

.send-btn {
  background: var(--primary-color);
  color: white;
  border: none;
  padding: 10px 20px;
  border-radius: 4px;
  cursor: pointer;
}

.button {
  background-color: var(--primary-color);
  color: white;
  border: none;
  cursor: pointer;
  transition: background-color 0.3s ease;
  border-radius: 8px;

  &:hover {
    background-color: color-mix(in srgb, var(--primary-color) 80%, black);
  }

  &:disabled {
    background-color: #bdc3c7;
    cursor: not-allowed;
  }
}

ul {
  list-style-type: none;
  padding: 0;
}

li {
  background-color: white;
  margin: 10px 0;
  padding: 10px;
  border-radius: 3px;
  box-shadow: 0 0 5px rgba(0, 0, 0, 0.1);
}

.error {
  color: var(--error-color);
  font-weight: bold;
}

.footer {
  margin-top: 20px;
  padding-top: 20px;
  border-top: 1px solid var(--secondary-color);
  display: flex;
  justify-content: space-around;
}

.footer-link {
  color: var(--primary-color);
  text-decoration: none;
  font-weight: bold;

  &:hover {
    text-decoration: underline;
  }
}
