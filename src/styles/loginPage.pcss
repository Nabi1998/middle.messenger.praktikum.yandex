.login-card {
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 2px 12px rgb(0 0 0 / 10%);
  font-family: sans-serif;
  margin: 50px auto;
  max-width: 320px;
  padding: 30px;
  text-align: center;
}

.login-title {
  color: #333;
  font-size: 24px;
  margin-bottom: 24px;
}

.login-label {
  color: #666;
  display: block;
  font-size: 12px;
  margin-bottom: 4px;
  margin-top: 12px;
  text-align: left;
}

.login-form input {
  border: none;
  border-bottom: 1px solid var(--primary-color);
  font-size: 14px;
  margin-bottom: 8px;
  outline: none;
  padding: 10px;
  width: 100%;
}

.login-footer {
  color: var(--primary-color);
  margin-top: 16px;
}

.register-link {
  color: var(--primary-color);
  font-size: 14px;
  text-decoration: none;
}

.login-button {
  border-radius: 5px;
}

.app-header {
  background-color: #f5f5f5;
  border-bottom: 1px solid #ddd;
  padding: 12px 0;
  text-align: center;
}

.nav-bar {
  background-color: #f5f5f5;
}

.nav-list {
  display: flex;
  gap: 15px;
  list-style: none;
  margin: 0;
  padding: 0;
}

.nav-link {
  border-radius: 4px;
  color: #333;
  font-weight: 500;
  padding: 6px 12px;
  text-decoration: none;
  transition:
    background-color 0.2s ease,
    color 0.2s ease;
}

.nav-link:hover {
  color: var(--primary-color-blue);
}

.nav-link:active,
.nav-link.active {
  background-color: var(--primary-color-blue);
  color: var(--background-color-white);
}

.nav-list .nav-item {
  background-color: transparent;
  border-radius: 0;
  box-shadow: none;
  margin: 0;
  padding: 0;
}
