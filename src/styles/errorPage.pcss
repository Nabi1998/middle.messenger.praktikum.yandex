.error-page {
  align-items: center;
  display: flex;
  height: 100vh;
  justify-content: center;
  text-align: center;
}

.error-content {
  max-width: 400px;
}

.error-code {
  color: #d32f2f;
  font-size: 96px;
  font-weight: bold;
  margin: 0;
}

.error-message {
  color: #555;
  font-size: 24px;
  margin: 16px 0;
}

.back-button {
  background-color: var(--primary-color);
  border-radius: 4px;
  color: white;
  display: inline-block;
  margin-top: 24px;
  padding: 10px 20px;
  text-decoration: none;
  transition: background-color 0.3s;
}

.back-button:hover {
  background-color: var(--primary-color);
}
